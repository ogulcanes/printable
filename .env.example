# Bu dosyayı `.env` adıyla kopyalayıp değerleri doldurun.
# `.env` gitignore'da; gerçek anahtarlar asla depoya girmez.
# Aynı değerler Vercel veya Alastyr panelindeki ortam değişkenlerine de girilmeli.

# ---------- Yönetim girişi ----------
# ÖNEMLİ: yayına almadan önce mutlaka değiştirin. Boş bırakılırsa kodda yazan
# varsayılanlar (admin / printable-admin) geçerli olur ve panel herkese açık kalır.
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-long-random-secret

# ---------- Müşteri şifre yenileme e-postası (Resend) ----------
# https://resend.com üzerinden bir API anahtarı oluşturun ve printable.com.tr
# alan adını doğrulayın. Bu ayarlar olmadan kayıt/giriş çalışır; yalnızca
# "şifremi unuttum" e-postası gönderilemez.
RESEND_API_KEY=
MAIL_FROM="Printable <noreply@printable.com.tr>"
# Yeni sipariş, üyelik, 3D teklif ve iletişim bildirimlerinin gideceği ek adresler
# (virgülle ayırın). info@printable.com.tr kod tarafından daima alıcı olarak eklenir.
STORE_NOTIFICATION_EMAILS="info@printable.com.tr"

# ---------- Shopier ürün senkronizasyonu ----------
# Shopier > Hesabım > Kişisel Erişim Anahtarı bölümünden oluşturulan PAT.
# Yalnızca sunucuda/Vercel'de tutulur; frontend'e veya GitHub'a yazılmaz.
SHOPIER_API_KEY=
# Shopier geç yanıt verirse Printable ürün kaydı korunur ve panelde yeniden
# gönderilebilir. Milisaniye; izin verilen aralık 1000-20000.
SHOPIER_TIMEOUT_MS=10000

# ---------- PayTR iFrame API ----------
# PayTR Mağaza Paneli → Bilgi sayfasındaki değerlerdir. Anahtar ve salt yalnızca
# sunucuda/Vercel'de tutulur; frontend'e veya GitHub'a kesinlikle yazılmaz.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Entegrasyon testi bitene kadar 1; gerçek tahsilatı açmak için bilinçli olarak 0 yapın.
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=1
# 0 = taksit seçenekleri açık, 1 = yalnızca tek çekim.
PAYTR_NO_INSTALLMENT=0
# 0 = PayTR/kanuni üst sınır; veya 2-12 arası izin verilen bir değer.
PAYTR_MAX_INSTALLMENT=0
PAYTR_TIMEOUT_LIMIT=30
# PayTR panelindeki Bildirim URL:
# https://www.printable.com.tr/api/paytr/callback

# ---------- Veritabanı (Supabase Postgres) ----------
# Supabase panel → Settings → Database → Connection string → URI
# Sunucusuz ortamda (Vercel) "Transaction pooler" olanı seçin: port 6543.
# Doğrudan bağlantı (5432) kısa ömürlü çok sayıda bağlantıda tükenir.
# Boş bırakılırsa yerelde gömülü Postgres (data/pgdata) kullanılır.
DATABASE_URL=

# ---------- Veritabanı (Alastyr MySQL/MariaDB) ----------
# Alastyr panelinde oluşturulan veritabanının bağlantısı. Bu doluysa DATABASE_URL
# yerine MySQL kullanılır. Paroladaki @, :, / gibi karakterleri URL-encode edin.
# Örnek: mysql://kullanici:parola@localhost:3306/veritabani
MYSQL_URL=

# ---------- Dosya depolama (Supabase Storage) ----------
# Supabase panel → Settings → API
# service_role anahtarı GİZLİDİR: yalnızca sunucuda kullanılır, tarayıcıya gitmez.
# Storage sekmesinde iki kova oluşturun:
#   images → Public işaretli   (ürün / banner / kategori görselleri)
#   models → Public DEĞİL      (müşteri STL/3MF dosyaları gizli kalmalı)
# Boş bırakılırsa dosyalar yerel diske yazılır. Vercel'de kalıcı değildir;
# Alastyr gibi kalıcı disk sunan Node hostingde üretim için uygundur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alastyr kalıcı disk yolları. Boşsa proje içindeki uploads/ (herkese açık
# görseller) ve private_uploads/ (yalnızca admin) kullanılır.
PUBLIC_UPLOAD_DIR=
PRIVATE_UPLOAD_DIR=

# ---------- Google müşteri yorumları (Places API New) ----------
# Anahtar yalnızca sunucuda kullanılır. Google Cloud'da Places API (New) açık olmalı.
GOOGLE_PLACES_API_KEY=
# Printable Google Haritalar işletme kaydının Place ID değeri.
GOOGLE_PLACE_ID=ChIJW2fEbgS3yhQRCOXPdRDDGJk
# İsteğe bağlı: "yorum yaz" düğmesinin doğrudan açacağı Google Maps adresi.
GOOGLE_MAPS_REVIEW_URL=https://www.google.com/maps/search/?api=1&query=Printable%203D%20Bask%C4%B1%20At%C3%B6lyesi&query_place_id=ChIJW2fEbgS3yhQRCOXPdRDDGJk

# ---------- Sunucu ----------
PORT=3000

# GA4 sunucu taraflı satın alma ölçümü (Measurement Protocol).
# Ödeme onaylandığı anda satış GA4'e sunucudan bildirilir; müşteri ödeme
# sonrası siteye dönmese bile kayıt oluşur. Boş bırakılırsa ölçüm yalnızca
# tarayıcıdan yapılır — site normal çalışır, sadece bazı satışlar kaçar.
# Nereden alınır: GA4 → Yönetici → Veri akışları → akış →
#   "Measurement Protocol API gizli anahtarları" → Oluştur
# GİZLİDİR: istemciye asla gönderilmez, depoya yazılmaz.
GA_API_SECRET=
